{
  "$schema": "./node_modules/knip/schema.json",
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "workspaces": {
    ".": {
      "entry": [
        "tools/bundle/*.mjs",
        "tools/relay/check-static.ts",
        "tools/relay/create-credentials.ts",
        "tools/relay/write-qr.ts",
        "tools/proofs/sveltekit3/{prepare,preflight,build,matrix-shell}.mjs"
      ]
    },
    "packages/*": {},
    "tools/*": {},
    "packages/relay-dev": {
      "entry": ["test/remote-ui-server.ts"]
    },
    "packages/web": {
      "ignoreBinaries": ["openssl"],
      "entry": [
        "scripts/*.mjs",
        "svgo.config.d.mts",
        "e2e/design/wireframe.config.ts",
        "e2e/design/wireframe.render.ts"
      ]
    }
  },
  "ignoreIssues": {
    "tools/proofs/sveltekit3/matrix-shell.mjs": ["unlisted"]
  }
}
