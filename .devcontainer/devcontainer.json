// Dev Container (containers.dev, 선택). 표준은 호스트 실행이다(AGENTS.md §5). Codespaces처럼 호스트 도구가 없을 때 쓴다.
// compose.yaml의 dev 서비스를 그대로 쓰므로(CI와 같은 이미지) 안에서는 npm, android/gradlew를 그냥 실행하면 되고 스크린샷도 비교한다.
{
  "name": "p2p-gostop",
  "dockerComposeFile": "../compose.yaml",
  "service": "dev",
  "runServices": ["dev"],
  "workspaceFolder": "/work",
  "remoteUser": "dev",
  "updateRemoteUserUID": true,
  // compose 서비스에는 상주 명령이 없으므로 도구가 대기 명령으로 바꿔 띄운다
  "overrideCommand": true,
  "shutdownAction": "stopCompose",
  "forwardPorts": [5173, 17777],
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "mounts": ["source=p2p-gostop-claude-${devcontainerId},target=/home/dev/.claude,type=volume"],
  "postCreateCommand": "npm ci",
  "customizations": {
    "vscode": {
      "extensions": [
        "svelte.svelte-vscode",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "oxc.oxc-vscode",
        "JetBrains.kotlin-server"
      ]
    }
  }
}
