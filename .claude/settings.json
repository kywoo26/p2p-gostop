{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm run verify)",
      "Bash(npm run lint *)",
      "Bash(npm run lint:fix *)",
      "Bash(npm run check *)",
      "Bash(npm test *)",
      "Bash(npm run test:browser *)",
      "Bash(npm run build -w packages/web *)",
      "Bash(npm run e2e -w packages/web *)",
      "Bash(npm run dev -w packages/web *)",
      "Bash(npm run start -w packages/relay-dev *)",
      "Bash(npm run android)",
      "Bash(android/gradlew -p android *)",
      "Bash(tools/setup-host.sh)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh release view *)",
      "Bash(gh release list *)",
      "Bash(gh pr merge *)",
      "Bash(git push * main)",
      "Bash(git push *:main)"
    ],
    "ask": [
      "Bash(gh release create *)",
      "Bash(gh release delete *)",
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push *--tags*)",
      "Bash(git push * v*)",
      "Bash(docker volume rm *)",
      "Bash(docker volume prune*)",
      "Bash(docker system prune*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(secrets/**)",
      "Read(*.jks)",
      "Read(*.keystore)",
      "Read(*.p12)",
      "Read(*.pem)"
    ]
  }
}
