{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./dev.sh install)",
      "Bash(./dev.sh lint *)",
      "Bash(./dev.sh lint:fix *)",
      "Bash(./dev.sh check *)",
      "Bash(./dev.sh test *)",
      "Bash(./dev.sh test:browser *)",
      "Bash(./dev.sh build:web *)",
      "Bash(./dev.sh e2e *)",
      "Bash(./dev.sh ci)",
      "Bash(./dev.sh apk:debug)",
      "Bash(./dev.sh android:test)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh release view *)",
      "Bash(gh release list *)",
      "Bash(gh pr merge *)",
      "Bash(git push * main)",
      "Bash(git push *:main)"
    ],
    "ask": [
      "Bash(gh release create *)",
      "Bash(gh release delete *)",
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push *--tags*)",
      "Bash(git push * v*)",
      "Bash(docker volume rm *)",
      "Bash(docker volume prune*)",
      "Bash(docker system prune*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(secrets/**)",
      "Read(*.jks)",
      "Read(*.keystore)",
      "Read(*.p12)",
      "Read(*.pem)"
    ]
  }
}
