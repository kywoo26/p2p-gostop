{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'f=$(jq -r .tool_input.file_path); \"${CLAUDE_PROJECT_DIR:-.}/dev.sh\" format:file \"$f\" >/dev/null 2>&1 || true'",
            "timeout": 60
          }
        ]
      }
    ]
  }
}